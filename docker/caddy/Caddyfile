blotils.prinzpiuz.in {
    reverse_proxy blotils:8000

    header {
        # Prevents the browser from MIME-sniffing a response away from the declared content type.
        X-Content-Type-Options nosniff

        # Prevents clickjacking attacks by controlling how the page can be framed.
        X-Frame-Options SAMEORIGIN

        # Forces browsers to use HTTPS for a specified duration to prevent downgrade attacks.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Controls which external resources the browser is allowed to load.
        # This is a good starting point, but you should customize it.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
}
