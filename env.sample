# ===================
# BloTils Environment
# ===================

# Application
BT_ENV=dev                          # dev, staging, production
BT_BASE_URL=http://localhost:8000   # Used for email links

# Database
BT_DBLOCATION=./BloTils.db

# ===================
# SMTP Configuration
# ===================
BT_SMTP_ENABLED=false               # Set to true to enable emails
BT_SMTP_HOST=                       # SMTP server host
BT_SMTP_PORT=587                    # Usually 587 for TLS
BT_SMTP_USERNAME=                   # SMTP username (often your email)
BT_SMTP_PASSWORD=                   # SMTP password or app-specific password
BT_SMTP_FROM=noreply@blotils.com    # From email address
BT_SMTP_FROMNAME=BloTils            # From display name
